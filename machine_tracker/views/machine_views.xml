<odoo>
    <!-- Form View -->
    <record id="view_machine_tracker_form" model="ir.ui.view">
        <field name="name">machine.tracker.form</field>
        <field name="model">machine.tracker</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List/Tree View -->
    <record id="view_machine_tracker_tree" model="ir.ui.view">
        <field name="name">machine.tracker.tree</field>
        <field name="model">machine.tracker</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="location"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_machine_tracker" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">machine.tracker</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>